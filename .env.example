# Copie este arquivo para .env.local para rodar localmente com `npm run dev`.
# Em produção (Vercel), configure estas mesmas variáveis em:
# Project Settings -> Environment Variables.

# Connection string do Postgres. Se você criar o banco pela aba "Storage"
# do painel do Vercel (Neon ou Vercel Postgres), esta variável é preenchida
# automaticamente -- não precisa copiar/colar nada.
POSTGRES_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Senha única para entrar no app (defina a sua). Não existe cadastro de
# usuário nem "esqueci minha senha" -- é um cadeado simples para uso pessoal.
APP_PASSWORD="escolha-uma-senha-forte-aqui"
